@@ -54,3 +59,22 @@
         .unwrap()
     }
 }
+
+/// MXNestSpirit: the strip outline. A plain rectangle, or -- when
+/// `corner_notch` is set -- the same rectangle with a square cut out of each
+/// corner. Everything outside the outline is exterior, so no item can be
+/// placed in a notch. On a strip too short for four notches, the notch is
+/// reduced so the outline stays a valid simple polygon.
+fn strip_outline(s: &Strip) -> SPolygon {
+    let (w, h) = (s.width, s.fixed_height);
+    let n = s.corner_notch.min(w * 0.45).min(h * 0.45);
+    if n <= 0.0 {
+        return SPolygon::from(Rect::try_new(0.0, 0.0, w, h).unwrap());
+    }
+    let pts = vec![
+        Point(n, 0.0), Point(w - n, 0.0), Point(w - n, n), Point(w, n),
+        Point(w, h - n), Point(w - n, h - n), Point(w - n, h), Point(n, h),
+        Point(n, h - n), Point(0.0, h - n), Point(0.0, n), Point(n, n),
+    ];
+    SPolygon::new(pts).unwrap_or_else(|_| SPolygon::from(Rect::try_new(0.0, 0.0, w, h).unwrap()))
+}
