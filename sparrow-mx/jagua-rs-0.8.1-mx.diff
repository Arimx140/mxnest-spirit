@@ -51,7 +51,21 @@
             * 1.00001;
 
         // add the shape offset if any, the strip needs to be at least `offset` wider than the items
-        let fitted_width = item_x_max + self.strip.shape_modify_config.offset.unwrap_or(0.0);
+        let offset = self.strip.shape_modify_config.offset.unwrap_or(0.0);
+        let mut fitted_width = item_x_max + offset;
+
+        // MXNestSpirit: an item lying in the band of a far-end corner must end
+        // a whole notch before the end of the strip, or the notch would cut it.
+        let n = self.strip.corner_notch;
+        if n > 0.0 {
+            let (lo, hi) = (n + offset, self.strip.fixed_height - n - offset);
+            for pi in self.layout.placed_items.values() {
+                let b = &pi.shape.bbox;
+                if b.y_min < lo || b.y_max > hi {
+                    fitted_width = fitted_width.max(b.x_max * 1.00001 + n + offset);
+                }
+            }
+        }
 
         self.change_strip_width(fitted_width);
         debug_assert_eq!(feasible_before, self.layout.is_feasible());
